# Configurações da Z-API para envio em GRUPO do WhatsApp
ZAPI_INSTANCE_ID=SEU_INSTANCE_ID_AQUI
ZAPI_TOKEN=SEU_TOKEN_AQUI
ZAPI_CLIENT_TOKEN=SEU_CLIENT_TOKEN_DE_SEGURANCA_DA_CONTA_AQUI

# Opção 1: Colocar o ID do Grupo da Z-API (Ex: 120363012345678901-group)
# Para descobrir o ID de todos os seus grupos, rode: npm run list-groups
ZAPI_GROUP_ID=120363000000000000-group

# Opção 2: Ou basta colocar o NOME do grupo (o agente busca o ID sozinho na Z-API!)
ZAPI_GROUP_NAME=
