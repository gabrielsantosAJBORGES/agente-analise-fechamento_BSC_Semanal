# Configurações da Z-API para envio no WhatsApp
ZAPI_INSTANCE_ID=SEU_INSTANCE_ID_AQUI
ZAPI_TOKEN=SEU_TOKEN_AQUI
ZAPI_CLIENT_TOKEN=SEU_CLIENT_TOKEN_DE_SEGURANCA_DA_CONTA_AQUI

# Número(s) ou ID de Grupo que vão receber o fechamento (separados por vírgula se for mais de um)
# Exemplo número: 5511999999999
# Exemplo grupo: 120363000000000000-group
ZAPI_TARGET_PHONE=5511999999999

# (Opcional - Usado apenas no GitHub Actions) Sessão do Google em Base64
GOOGLE_STORAGE_STATE_BASE64=
